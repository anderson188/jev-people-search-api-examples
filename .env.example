# Copy to .env and fill in. Never commit .env.
# Create a key at https://jevtypesafe.org/account/ (starts with jv_live_).

JEV_API_KEY=jv_live_YOUR_KEY_HERE
JEV_BASE_URL=https://jevtypesafe.org

# Work-email find. Use a person you have a lawful basis to look up.
FULL_NAME=Jane Doe
DOMAIN=acme.com
# LINKEDIN_URL=https://www.linkedin.com/in/example
VERIFY=true

# ICP gate (Jev decide) before spending a People Search credit.
ICP=B2B SaaS company; keep engineering, product, or revenue leaders
TITLE=VP Engineering
COMPANY=Acme
MIN_CONFIDENCE=0.6
